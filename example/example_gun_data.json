{
  "taczfixes": {
    // 可供使用的改装点数，不填则为无限
    "refit_point": 100,
    "jump_inaccuracy": {
      // 滞空散布倍率
      "multiplier": 2.0,
      // 滞空散布倍率的涨落速度，percent/tick
      "speed": 0.5
    },
    "damage_by_distance": {
      // 优势射程，能被配件的effective_range修改
      "effective_range": 15,
      // x为(飞行距离-优势射程)
      // 武器最终造成的伤害为(y*原伤害)
      "function": "if (x >= 30) then y = 1.5 - x / 60 else y = 2.0 - x / 30 end"
    },
    // 是否允许加速拉栓/加速换弹时同步加速动画播放
    "allow_animation_zoom": true,
    "bullet_in_barrel": 1,
    // 四肢伤害倍率；不填则使用配置文件中的默认值。
    "limb_factor": 0.6,
    // 连射惩罚。
    "inaccuracy_multiplier": {
      // 相应移动状态的连射惩罚，不填则使用配置文件中的默认值。
      // 可选stand，aim，lie，sneak，move
      // 如果其他情况下的连射惩罚没有填写，那么默认使用stand中的值。
      "stand": {
        // 散布开始回复的延迟，单位毫秒。
        "cooldown_delay": 100,
        // 散布回复的速度，0.1则为每tick回复10%。
        "cooldown_speed": 0.1,
        // 射击多少次后连射惩罚达到最大值。
        "max_stack": 30,
        // 每次射击按百分比增加的散布。
        "shot_percent": 0.03,
        // 每次射击固定增加的散布。
        "shot_addend": 0.02
      }
    },
    //首发后坐力倍率
        "recoil_multiplier": {
      // 相应开火模式下的后坐力倍率。不填则使用配置文件中的默认值。
      // 可选auto，semi，burst
      "auto": {
        // 宽容时间，单位毫秒。
        "window": 200,
        // 修饰器名称，必须为modifier_*。不可重复。
        "modifier_1": {
          // 在第count发触发此倍率。
          "count": 1,
          // 竖直后坐力倍率。
          "pitch_multiplier": 3.0,
          // 水平后坐力倍率。
          "yaw_multiplier": 2.0
          // 宽容时间，单位毫秒。
        },
        "modifier_2": {
          // 可以是区间
          "count": [2,3],
          "pitch_multiplier": 1.5,
          "yaw_multiplier": 1.5
        },
        "modifier_3": {
          // 如果区间只有一项n，那么视为[n,+∞)
          "count": [4],
          "pitch_multiplier": 0.5,
          "yaw_multiplier": 0.5
        },
        "modifier_4": {
          // 第三项为步长
          "count": [5,"infinite",5],
          "pitch_multiplier": 3,
          "yaw_multiplier": 0.2
        }
      }
    },
    "fire_knockback": {
      // 开火击退力度。
      "power": 0.015,
      // 潜行时开火击退力度。
      "power_sneak": 0.005,
      // 半自动时的力度倍率。
      "multiplier_semi": 4.0,
      // 连发时的力度倍率。
      "multiplier_burst": 2.0
    },
    // 自定义配件槽位
    "attachment_slots": {
      // 槽位id，对应模型文件中的*_pos，*_default，*_adapter。
      // 不能为tacz已有的id。
      "laser2": {
        // 槽位类型，可选laser，grip，muzzle，stock，scope，custom。
        // 如果不为custom，那么使用相应类型的槽位名称和贴图，可以安装相应类型的配件。
        "type": "laser",
        // 需要这些槽位有指定配件才启用此槽位。
        // 若是true，那么只要这个槽位上有配件就启用此槽位。
        "dependence": {
          "laser": true,
          "scope": [
            "#tacz:scope"
          ]
        },
        // 如果这些槽位有这些配件，禁用此槽位。
        "conflict": {
          "handguard": [
            "#tacz:handguard"
          ]
        }
      },
      "handguard": {
        "type": "custom",
        // 如果槽位类型为custom，用此字段指定其本地化键名。
        "name": "tacz.slot.handguard.name",
        // 如果槽位类型为custom，用此字段指定其icon。
        "slot": "tacz:slot/handguard",
        // 允许安装配件的列表。
        "allow_attachments": [
          "#tacz:handguard",
          "tacz:laser_compact"
        ]
      },
      "scope2": {
        "type": "scope",
        "allow_attachments": [
          "#tacz:scope_sight"
        ],
        // 开镜时枪身的倾斜角度。
        "angle": 45.0,
        // 开镜视角位置偏移量，0.1即向后移动0.1单位。
        "offset": 0.1
      }
    }
  }
}
