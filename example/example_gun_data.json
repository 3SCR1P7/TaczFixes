{
  "taczfixes": {
    //四肢伤害倍率；不填则使用配置文件中的默认值。
    "limb_factor": 0.6,
    //连射惩罚。
    "inaccuracy_multiplier": {
      // 相应移动状态的连射惩罚，不填则使用配置文件中的默认值。
      // 可选stand，aim，lie，sneak，move
      // 如果其他情况下的连射惩罚没有填写，那么默认使用stand中的值。
      "stand": {
        // 散布开始回复的延迟，单位毫秒。
        "cooldown_delay": 100,
        // 散布回复的速度，0.1则为每tick回复10%。
        "cooldown_speed": 0.1,
        // 射击多少次后连射惩罚达到最大值。
        "max_stack": 30,
        // 每次射击按百分比增加的散布。
        "shot_percent": 0.03,
        // 每次射击固定增加的散布。
        "shot_addend": 0.02
      }
    },
    //首发后坐力倍率
        "recoil_multiplier": {
      // 相应开火模式下的后坐力倍率。不填则使用配置文件中的默认值。
      // 可选auto，semi，burst
      "auto": {
        // 宽容时间，单位毫秒。
        "window": 200,
        // 修饰器名称，必须为modifier_*。不可重复。
        "modifier_1": {
          // 在第count发触发此倍率。
          "count": 1,
          // 竖直后坐力倍率。
          "pitch_multiplier": 3.0,
          // 水平后坐力倍率。
          "yaw_multiplier": 2.0
          // 宽容时间，单位毫秒。
        },
        "modifier_2": {
          // 可以是区间
          "count": [2,3],
          "pitch_multiplier": 1.5,
          "yaw_multiplier": 1.5
        },
        "modifier_3": {
          // 如果区间只有一项n，那么视为[n,+∞)
          "count": [4],
          "pitch_multiplier": 0.5,
          "yaw_multiplier": 0.5
        }
      }
    },
    "fire_knockback": {
      // 开火击退力度。
      "power": 0.015,
      // 潜行时开火击退力度。
      "power_sneak": 0.005,
      // 半自动时的力度倍率。
      "multiplier_semi": 4.0,
      // 连发时的力度倍率。
      "multiplier_burst": 2.0
    },
    // 自定义配件槽位
    "attachment_slots": {
      // 槽位id，对应模型文件中的*_pos，*_default，*_adapter。
      // 不能为tacz已有的id。
      "laser2": {
        // 槽位类型，可选laser，grip，muzzle，stock，scope，custom。
        // 如果不为custom，那么使用相应类型的槽位名称和贴图，可以安装相应类型的配件。
        "type": "laser",
        // 需要这些槽位有指定配件才启用此槽位。
        // 若是true，那么只要这个槽位上有配件就启用此槽位。
        "dependence": {
          "laser": true,
          "scope": [
            "#tacz:scope"
          ]
        },
        // 如果这些槽位有这些配件，禁用此槽位。
        "conflict": {
          "handguard": [
            "#tacz:handguard"
          ]
        }
      },
      "handguard": {
        "type": "custom",
        // 如果槽位类型为custom，用此字段指定其本地化键名。
        "name": "tacz.slot.handguard.name",
        // 如果槽位类型为custom，用此字段指定其icon。
        "slot": "tacz:slot/handguard",
        // 允许安装配件的列表。
        "allow_attachments": [
          "#tacz:handguard",
          "tacz:laser_compact"
        ]
      },
      "scope2": {
        "type": "scope",
        "allow_attachments": [
          "#tacz:scope_sight"
        ],
        // 开镜时枪身的倾斜角度。
        "angle": 45.0,
        // 开镜视角位置偏移量，0.1即向后移动0.1单位。
        "offset": 0.1
      }
    }
  },
  // 指定枪械弹药
  "ammo": "tacz:762x39",
  // 弹容
  "ammo_amount": 30,
  // 扩容弹夹弹药总数
  "extended_mag_ammo_amount": [
    34,
    37,
    40
  ],
  // 指定逻辑机及相关数值的修改
  "script": "tacz:xmag_reload_logic",
  "script_param": {
    "reload_feed": 1.55,
    "reload_cooldown": 2.0,
    "empty_feed": 2.25,
    "empty_cooldown": 2.6,
    "reload_xmag_1_feed": 1.54,
    "reload_xmag_1_cooldown": 2.29,
    "empty_xmag_1_feed": 2.5,
    "empty_xmag_1_cooldown": 2.85,
    "reload_xmag_2_feed": 1.54,
    "reload_xmag_2_cooldown": 2.29,
    "empty_xmag_2_feed": 2.5,
    "empty_xmag_2_cooldown": 2.85,
    "reload_xmag_3_feed": 1.54,
    "reload_xmag_3_cooldown": 2.29,
    "empty_xmag_3_feed": 2.5,
    "empty_xmag_3_cooldown": 2.85
  },
  // 是否允许趴下
  "can_crawl": true,
  // 是否允许斜握（仅视觉效果）
  "can_slide": true,
  // 枪栓类型：开膛待机（open_bolt）、闭膛待击（closed_bolt）、手动上膛（manual_action)
  "bolt": "closed_bolt",
  // 每分钟射出弹药量，最大不应超过 1200
  "rpm": 600,
  // 子弹实体属性
  "bullet": {
    // 寿命，单位秒
    "life": 0.8,
    // 用于霰弹，默认为 1，每发的伤害 / bullet_amount，每次射击扣除一发子弹
    "bullet_amount": 1,
    // 伤害
    "damage": 9,
    // 曳光弹间隔数量，没有此字段则不发射曳光弹
    // 设置为 0 则是每发都是曳光弹
    "tracer_count_interval": 0,
    // 额外伤害的内容，为空则表示没有任何额外伤害计算内容
    "extra_damage": {
      // 护甲穿透率，默认为 0，也就是没有穿甲伤害
      "armor_ignore": 0.25,
      // 爆头伤害 x1.5
      "head_shot_multiplier": 1.5,
      // 距离-伤害分段常函数
      "damage_adjust": [
        {"distance": 30, "damage": 9},
        {"distance": 60, "damage": 7.5},
        // 如果你忘记写这个无穷，那么超过上述距离，我就认为是 0
        {"distance": "infinite", "damage": 6}
      ]
    },
    // 速度 m/s
    "speed": 250,
    // 重力
    "gravity": 0.15,
    // 击退效果
    "knockback": 0,
    // 阻力
    "friction": 0.02,
    // 点燃目标
    // "ignite": false,
    "ignite": {
      // 点燃实体
      "entity": false,
      // 点燃方块
      "block": false
    },
    // 点燃时间，默认为 2 秒，仅用于实体
    "ignite_entity_time": 2,
    // 穿透数
    "pierce": 1
  },
  // 射击声音传播距离修正
  "fire_sound": {
    // 射击声音传播距离修正乘数
    "fire_multiplier": 1.0,
    // 消音器射击声音传播距离修正乘数
    "silence_multiplier": 1.0
  },
  // 换弹相关
  "reload": {
    // magazine 是弹匣供弹，manual 是手动供弹，fuel 是类燃料罐供弹（消耗一个物品填满），inventory 是消耗背包内弹药供弹（背包直读）
    "type": "magazine",
    // 无限备弹，注意，目前此项与“inventory”不兼容
    "infinite": false,
    // 弹匣供弹换弹时长（秒），到达此时间点，服务端就更新枪内子弹数量
    "feed": {
      // 空仓换弹
      "empty": 2.25,
      // 战术换弹
      "tactical": 1.55
    },
    // 弹匣供弹总时长（秒），到达此时间点，枪械才可以进行开火、检视等行为。
    "cooldown": {
      // 空仓换弹
      "empty": 2.6,
      // 战术换弹
      "tactical": 2.0
    }
  },
  // 枪械抬起的动作时长，单位秒。
  // 抬起动作完成后，枪械可以进行开火、检视等行为
  "draw_time": 0.35,
  // 收枪的动作时长，单位秒。
  "put_away_time": 0.57,
  // 瞄准时长，单位秒。
  "aim_time": 0.2,
  "sprint_time": 0.2,
  "weight": 3.5,
  "movement_speed": {
    // 默认修正
    "base": 0.0,
    // 瞄准时
    "aim": -0.2,
    // 换弹时
    "reload": -0.15
  },
  // 开火模式
  "fire_mode": [
    // 全自动
    "auto",
    // 半自动
    "semi"
  ],
  "crawl_recoil_multiplier": 0.5,
  // 后坐力
  "recoil": {
    "pitch": [
      {"time": 0, "value": [0.66, 0.66]},
      {"time": 0.1, "value": [0.66, 0.66]},
      {"time": 0.45, "value": [-0.175, -0.175]},
      {"time": 0.6, "value": [0, 0]}
    ],
    "yaw": [
      {"time": 0, "value": [-0.23, 0.18]},
      {"time": 0.35, "value": [0, 0]}
    ]
  },
  // 受伤晃动幅度修改，乘数，1 为原版晃动程度，0 为完全不晃动，默认为 0.05
  "hurt_bob_tweak_multiplier": 0.05,
  // 不准确度
  "inaccuracy": {
    // 站立射击散布
    "stand": 4.5,
    // 移动射击散布
    "move": 5,
    // 潜行射击散布
    "sneak": 2.5,
    // 趴下射击散布
    "lie": 1.5,
    // 瞄准射击时散布
    "aim": 0.15
  },
  // 近战相关
  "melee": {
    // 枪械距离参数，用来延升近战攻击范围
    // 会与刺刀等配件的距离做加和
    "distance": 1,
    // 使用时的冷却时间
    // 会与刺刀等配件的冷却时间做加和
    "cooldown": 0.7,
    // 默认近战数据，会被配件的数据替换掉
    "default": {
      // 动画类型：没有枪托的为 melee_push，有枪托的为 melee_stock
      "animation_type": "melee_push",
      // 刺刀距离参数，枪械里还有个刺刀攻击距离参数，两者做加和
      "distance": 1,
      // 刺刀范围角度
      "range_angle": 40,
      // 刺刀冷却时间，枪械里还有个刺刀冷却时间参数，两者做加和
      "cooldown": 0,
      // 伤害值
      "damage": 1,
      // 击退效果
      "knockback": 0.5,
      // 前摇时长，单位：秒
      "prep": 0.1
    }
  },
  // 开放的配件槽。未指定的槽位默认关闭。全部配件槽类型有:
  // scope, stock, muzzle, grip, laser, extended_mag
  "allow_attachment_types": [
    "scope",
    "stock",
    "muzzle",
    "extended_mag"
  ]
}