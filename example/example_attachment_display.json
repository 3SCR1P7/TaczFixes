{
  "group_offset": {
    // 使laser_pos位置偏移x2 y3 z4。
    "laser": [2,3,4]
  }
  "stepless": {
    // 是否启用无极变倍。会替代tacz原版的变倍。
    "enable": true,
    // 最小倍率。
    "zoom_min": 1.25,
    // 最大倍率。
    "zoom_max": 6.25,
    // 倍率变化的速度。
    "speed": 0.5,
    // 未调整时，开镜默认的倍率。
    "zoom_default": 6.25
  },
  "slot": "tacz:attachment/slot/scope_lpvo_1_6",
  // 配件的默认模型，不可为空
  "model": "tacz:attachment/scope_lpvo_1_6_geo",
  // 配件默认模型使用的材质，不可为空
  "texture": "tacz:attachment/uv/scope_lpvo_1_6",
  // 只有 瞄具 配件需要设置这个属性，表示瞄具的放大倍率。
  // 玩家可以在数组设置的几个倍率之间切换
  "lod": {
    "model": "tacz:attachment/lod/scope_lpvo_1_6",
    "texture": "tacz:attachment/lod/scope_lpvo_1_6"
  },
  "zoom": [
    6.25,
    1.25
  ],
  "views": [
    2,
    2
  ],
  "views_fov": [
    30.0,
    60.0
  ],
  // 如果配件是瞄具，且为筒状放大瞄具，此选项应为true
  "scope": true,
  // 如果配件是瞄具，且为红点或全息瞄具，此选项应为true
  "sight": false,
  // 只有 瞄具 配件需要设置这个属性，表示开镜后，枪身和瞄具渲染的fov。
  // 默认情况下，mc 渲染手部模型的 fov 为 70。
  "sounds": {
    "install": "tacz:attachments/scope_general_c",
    "uninstall": "tacz:attachments/scope_general_c"
  }
}
