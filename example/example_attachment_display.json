{
  "group_offset": {
    // 使laser_pos位置偏移x2 y3 z4。
    "laser": [2,3,4]
  },
  "stepless": {
    // 是否启用无极变倍。会替代tacz原版的变倍。
    "enable": true,
    // 最小倍率。
    "zoom_min": 1.25,
    // 最大倍率。
    "zoom_max": 6.25,
    // 倍率变化的速度。
    "speed": 0.5,
    // 未调整时，开镜默认的倍率。
    "zoom_default": 6.25
  }
}
