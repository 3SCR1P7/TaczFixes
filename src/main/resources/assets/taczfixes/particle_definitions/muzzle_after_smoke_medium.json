{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "taczfixes:muzzle_after_smoke_medium",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "taczfixes:particle/muzzle_after_smoke_mist"
      }
    },
    "components": {
      "sbm:fp_emitter_local_space": { "position": true, "rotation": true, "velocity": false, "to_world": false },
      "minecraft:emitter_local_space": { "position": false, "rotation": true, "velocity": false },
      "minecraft:emitter_rate_instant": { "num_particles": 2 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.05 },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": ["math.random(-0.27, 0.27)", 1, "math.random(-0.10, 0.10)"]
      },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "math.random(0.36, 0.48)" },
      "minecraft:particle_initial_speed": "math.random(0.43, 0.70)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": ["0.20 * (v.particle_random_1 - 0.5)", 0.88, 0],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "math.lerp(0.08, 0.23, v.particle_age / v.particle_lifetime) * (0.89 + 0.22 * v.particle_random_2)",
          "math.lerp(0.11, 0.28, v.particle_age / v.particle_lifetime) * (0.89 + 0.22 * v.particle_random_2)"
        ],
        "facing_camera_mode": "rotate_y",
        "uv": {
          "texture_width": 1024,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [0, 0],
            "size_UV": [128, 128],
            "step_UV": [128, 0],
            "max_frame": 8,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFFFFF",
            "0.08": "#2DFFFFFF",
            "0.28": "#2DFFFFFF",
            "0.55": "#18FFFFFF",
            "0.82": "#09FFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
      }
    }
  }
}
